<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dome_viz</name>
  <version>0.1.0</version>
  <description>
    Friendly, read-only web view of the DOME robot's map as it is built.
    Runs on the viewer VM, never on the robot's Pi.
  </description>
  <maintainer email="pitosalas@gmail.com">pitosalas</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>dome_semantic_msgs</depend>
  <depend>dome_telemetry_msgs</depend>
  <exec_depend>dome_semantic</exec_depend>
  <exec_depend>python3-aiohttp</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
